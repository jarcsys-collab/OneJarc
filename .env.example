# OneJarc server — environment variables
#
# Copy to `.env` for local development (`.env` is git-ignored). On Railway, set
# these in the dashboard (service -> Variables); see .railway/railway.ts.
# NEVER commit real values: this repository is public.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# HTTP port. Railway injects PORT automatically; only needed locally. Not secret.
PORT=3000
# `production` on Railway. Leave empty locally. Not secret.
NODE_ENV=
# Public base URL of the app, no trailing slash. Not secret.
# Local: http://localhost:3000 — Railway: https://<service>.up.railway.app
# The Entra redirect URI is APP_BASE_URL + /auth/callback.
APP_BASE_URL=http://localhost:3000
# Express "trust proxy" setting (1 = trust the Railway edge proxy). Not secret.
TRUST_PROXY=1
# Folder with the static site, relative to the repo root. Not secret.
STATIC_DIR=site
# Log level (debug | info | warn | error). Not secret.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# SECRET. At least 32 random characters, e.g. `openssl rand -base64 48`.
# Use a different value locally and on Railway.
SESSION_SECRET=
# Session lifetime in hours. Not secret.
SESSION_MAX_AGE_HOURS=8

# ---------------------------------------------------------------------------
# Microsoft Entra ID (sign-in) — values from the Entra app registration
# (Azure portal -> Microsoft Entra ID -> App registrations -> your app)
# ---------------------------------------------------------------------------
# Login authority host. Not secret.
ENTRA_CLOUD_INSTANCE=https://login.microsoftonline.com/
# Directory (tenant) ID — "Overview" page. Not a secret, but keep it out of git.
ENTRA_TENANT_ID=
# Application (client) ID — "Overview" page. Not a secret, but keep it out of git.
ENTRA_CLIENT_ID=
# SECRET. Client secret value — "Certificates & secrets".
ENTRA_CLIENT_SECRET=
# Comma-separated Entra object IDs (oid) of administrators.
# Local .env: put your own oid. Keep real ids out of git.
ADMIN_OBJECT_IDS=

# ---------------------------------------------------------------------------
# MongoDB — tool catalog and sign-in sessions
# ---------------------------------------------------------------------------
# SECRET (contains the database password). Required when NODE_ENV=production.
# Railway: a reference to the MongoDB service, ${{MongoDB.MONGO_URL}}.
# Local: leave empty to keep the catalog and sessions in memory (lost on restart),
# or point it at a local mongod, e.g. mongodb://127.0.0.1:27017
MONGODB_URI=
# Database name inside the MongoDB server. Not secret.
MONGODB_DB=onejarc

# ---------------------------------------------------------------------------
# Chat assistant (Claude, via the Anthropic API)
# ---------------------------------------------------------------------------
# SECRET. Empty -> the chat answers "The OneJarc assistant is coming soon."
# Create a key at https://platform.claude.com (Settings -> API keys).
ANTHROPIC_API_KEY=
# Claude model id. Not secret.
CHAT_MODEL=claude-opus-5-5
# Messages per signed-in user per minute (cost guard). Not secret.
CHAT_RATE_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Dev auth bypass — local automated testing only; server refuses to start
# with it in production. Skips Entra and signs every request in as this user.
# ---------------------------------------------------------------------------
# DEV_AUTH_BYPASS_OID=
# DEV_AUTH_BYPASS_NAME=
# DEV_AUTH_BYPASS_EMAIL=
